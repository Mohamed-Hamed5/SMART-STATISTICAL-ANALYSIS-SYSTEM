theme = bs_theme(version = 5, bootswatch = "darkly"),
titlePanel("📊🔥 Ultimate Statistical Dashboard"),
sidebarLayout(
sidebarPanel(
radioButtons("source","📍 Data Source:", choices = c("Numbers","File")),
hr(),
conditionalPanel(
condition="input.source=='Numbers'",
textInput("data","Enter Numbers:", value="10 20 30 40 50 60")
),
conditionalPanel(
condition="input.source=='File'",
fileInput("file","Upload File"),
actionButton("clear_file","🧹 Clear File", class="btn-danger btn-sm"),
uiOutput("col_x"),
uiOutput("col_y")
),
hr(),
conditionalPanel(condition="input.tabs=='📊 Histogram'",
sliderInput("bins","📊 Bins:",5,50,20)),
conditionalPanel(condition="input.tabs=='📈 Density'",
sliderInput("adjust","📈 Smooth:",0.5,3,1,0.1)),
conditionalPanel(condition="input.tabs=='📏 SD Plot'",
sliderInput("sd_mult","📏 SD Multiplier:",0.5,3,1,0.1)),
conditionalPanel(condition="input.tabs=='🔮 Regression'",
numericInput("future_n","🔮 Future Points:",5,1,50)),
hr(),
downloadButton("download_plot","💾 Save Plot", class="btn-success w-100")
),
mainPanel(
tabsetPanel(id="tabs",
tabPanel("📋 Summary",verbatimTextOutput("summary")),
tabPanel("📊 Histogram",plotOutput("hist")),
tabPanel("📦 Boxplot",plotOutput("box")),
tabPanel("📈 Density",plotOutput("density")),
tabPanel("📏 SD Plot",plotOutput("sd")),
tabPanel("🧠 Normal Curve",plotOutput("normal")),
tabPanel("📐 QQ Plot",plotOutput("qq")),
tabPanel("📉 ECDF",plotOutput("ecdf")),
tabPanel("🔗 Relationship", plotOutput("rel"), verbatimTextOutput("corr")),
tabPanel("🔮 Regression",plotOutput("reg"))
)
)
)
)
