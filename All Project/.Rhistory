server <- function(input, output, session){
observeEvent(input$clear_file,{ reset("file") })
raw_data <- reactive({
req(input$file)
ext <- tools::file_ext(input$file$name)
df <- switch(ext,
csv  = read_csv(input$file$datapath, show_col_types = FALSE),
xlsx = read_excel(input$file$datapath),
sav  = read_sav(input$file$datapath))
df_num <- df[, sapply(df,is.numeric)]
validate(need(ncol(df_num)>0,"No numeric columns found in file"))
df_num
})
output$col_x <- renderUI({
req(raw_data())
selectInput("var1","X Variable:",choices=names(raw_data()))
})
output$col_y <- renderUI({
req(raw_data())
selectInput("var2","Y Variable:",choices=c("None",names(raw_data())))
})
clean_data <- reactive({
if(input$source=="Numbers"){
d <- as.numeric(unlist(strsplit(input$data,"[ ,]+")))
d <- d[is.finite(d)]
validate(need(length(d) > 0, "Please enter valid numbers"))
data.frame(X=d)
} else {
req(input$var1)
df <- raw_data()
validate(need(is.numeric(df[[input$var1]]),"X must be numeric"))
res <- data.frame(X=df[[input$var1]])
if(input$var2!="None"){
validate(need(is.numeric(df[[input$var2]]),"Y must be numeric"))
res$Y <- df[[input$var2]]
}
res <- res[complete.cases(res),]
validate(need(nrow(res)>0,"No valid data available in selected columns"))
res
}
})
output$summary <- renderPrint({
d <- clean_data()$X
n <- length(d)
mean_val <- mean(d); median_val <- median(d)
ux <- unique(d); mode_val <- ux[which.max(tabulate(match(d, ux)))]
if(length(ux) == n) mode_val <- "No unique mode"
var_val <- var(d); sd_val <- sd(d)
min_val <- min(d); max_val <- max(d); range_val <- max_val - min_val
q <- quantile(d); iqr_val <- IQR(d)
skew_val <- skewness(d); kurt_val <- kurtosis(d)
cat("========== 📊 FULL STATISTICAL SUMMARY ==========\n\n")
cat("🔢 Basic Info\nCount:", n, "\nMin:", min_val, "\nMax:", max_val, "\nRange:", range_val, "\n\n")
cat("📈 Central Tendency\nMean:", mean_val, "\nMedian:", median_val, "\nMode:", mode_val, "\n\n")
cat("📏 Dispersion\nVariance:", var_val, "\nStd Deviation:", sd_val, "\nIQR:", iqr_val, "\n\n")
cat("📊 Quartiles\nQ1:", q[2], "\nQ2 (Median):", q[3], "\nQ3:", q[4], "\n\n")
cat("🧠 Shape\nSkewness:", skew_val, "\nKurtosis:", kurt_val, "\n\n")
cat("📌 Percentiles\n"); print(quantile(d, probs = seq(0.1, 0.9, 0.1)))
})
# PLOTS
output$hist <- renderPlot({
d <- clean_data()$X
ggplot(data.frame(x=d),aes(x))+
geom_histogram(bins=input$bins, fill="skyblue", color="black")+
geom_vline(xintercept=mean(d,na.rm=TRUE), color="red", size=1)+
theme_minimal()
})
output$box <- renderPlot({
d <- clean_data()$X
ggplot(data.frame(x=d),aes(x=1,y=x))+
geom_boxplot(fill="orange", outlier.color = "red")+
geom_jitter(width=0.1,alpha=0.5,color = "black")+
